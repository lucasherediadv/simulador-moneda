      "y": 5448.553571428572,
      "width": 803.6700000000001,
      "height": 292.03125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 3,
