      "seed": 357037631,
      "version": 2,
      "versionNonce": 1079981725,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792030564532,
      "link": null,
      "locked": false,
      "text": "n = 10       casi siempre «Equilibrada» (~95 %)\n             margen ±0,316: el azar lo tapa todo\nn = 100      a veces sí, a veces no la detecta\n             margen ±0,10 ≈ diferencia 0,10\nn = 1.000    «Sesgada»   (margen ±0,032)\nn = 10.000   «Sesgada»   (margen ±0,010)\n\nMisma moneda: cambia cuántos datos tenemos.",
      "fontSize": 45.6,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "n = 10       casi siempre «Equilibrada» (~95 %)\n             margen ±0,316: el azar lo tapa todo\nn = 100      a veces sí, a veces no la detecta\n             margen ±0,10 ≈ diferencia 0,10\nn = 1.000    «Sesgada»   (margen ±0,032)\nn = 10.000   «Sesgada»   (margen ±0,010)\n\nMisma moneda: cambia cuántos datos tenemos.",
      "autoResize": true,
      "lineHeight": 1.25,
      "baseline": 41,
