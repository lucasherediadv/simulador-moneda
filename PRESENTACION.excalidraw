    {
      "id": "el101",
      "type": "text",
      "x": 124.26829268292673,
      "y": 8367.658536585366,
      "width": 1174.279024390244,
      "height": 455.8536585365854,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "el143",
