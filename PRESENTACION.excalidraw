    },
    {
      "id": "el059",
      "type": "text",
      "x": 372,
      "y": 5376.4,
      "width": 1100.736,
      "height": 441,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
