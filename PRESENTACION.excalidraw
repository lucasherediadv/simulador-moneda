      "locked": false,
      "text": "D. Variabilidad del azar",
      "fontSize": 62.4,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "D. Variabilidad del azar",
      "autoResize": true,
      "lineHeight": 1.25,
      "baseline": 56,
      "index": "b0K",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "el062",
      "type": "text",
      "x": 2692,
      "y": 5376.4,
      "width": 1044.288,
      "height": 441,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "el138",
      "roundness": null,
      "seed": 529120475,
      "version": 2,
      "versionNonce": 201309597,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792030564532,
      "link": null,
      "locked": false,
      "text": "Caras ~ Binomial(n, p)\nMedia = n·p     Desvío = √(n·p·(1−p))\n\nPara la frecuencia f, con p = 0,5:\n   σ(f) = 0,5 / √n\n   n = 100     →  σ = 0,05\n   n = 10.000  →  σ = 0,005",
      "fontSize": 50.4,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Caras ~ Binomial(n, p)\nMedia = n·p     Desvío = √(n·p·(1−p))\n\nPara la frecuencia f, con p = 0,5:\n   σ(f) = 0,5 / √n\n   n = 100     →  σ = 0,05\n   n = 10.000  →  σ = 0,005",
      "autoResize": true,
      "lineHeight": 1.25,
      "baseline": 45,
      "index": "b0L",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
