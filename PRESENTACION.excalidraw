    {
      "id": "el104",
      "type": "text",
      "x": 2444.268292682927,
      "y": 8367.658536585366,
      "width": 1225.3346341463416,
      "height": 455.8536585365854,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "el144",
