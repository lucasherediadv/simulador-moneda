      "boundElements": [],
      "updated": 1792030564532,
      "link": null,
      "locked": false,
      "text": "caras = 6\nf = 6 / 10 = 0,6\nd = |0,6 − 0,5| = 0,1\nmargen = 1/√10 = 0,316\n\n0,1 < 0,316   →   EQUILIBRADA",
      "fontSize": 33.4,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "caras = 6\nf = 6 / 10 = 0,6\nd = |0,6 − 0,5| = 0,1\nmargen = 1/√10 = 0,316\n\n0,1 < 0,316   →   EQUILIBRADA",
